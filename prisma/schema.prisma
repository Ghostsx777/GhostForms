generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  CREATOR
  MASTER
}
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum QuestionType {
  SHORT
  LONG
  SINGLE
  MULTIPLE
}
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  mustChangePassword Boolean @default(false)
  temporaryPasswordExpiresAt DateTime?
  passwordHash String
  role         Role          @default(CREATOR)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  forms        Form[]
  auditLogs    AuditLog[]
}
model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Form {
  id          String     @id @default(cuid())
  slug        String     @unique @default(uuid())
  ownerId     String
  title       String     @default("Formulário sem título")
  description String     @default("")
  background  String     @default("#0b0d12")
  cardColor   String     @default("#161922")
  buttonColor String     @default("#b5f5c6")
  published   Boolean    @default(false)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]
  cover       Cover?
  @@index([ownerId, updatedAt])
}
model Question {
  id          String       @id
  formId      String
  title       String
  description String       @default("")
  type        QuestionType
  required    Boolean      @default(false)
  color       String       @default("#161922")
  position    Int
  options     Json
  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]
  @@index([formId, position])
}
model Submission {
  id          String           @id @default(cuid())
  formId      String
  formVersion Int
  status      ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  moderatedAt DateTime?
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]
  @@index([formId, status, createdAt])
}
model Answer {
  id            String     @id @default(cuid())
  submissionId  String
  questionId    String?
  questionTitle String
  questionType  String
  position      Int
  value         Json
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  @@index([submissionId])
  @@index([questionId])
}
model Cover {
  formId String @id
  data   Bytes
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
}
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([createdAt])
}
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model AppSettings {
  id String @id @default("global")
  autoApproveAccounts Boolean @default(false)
}
